        def on_ai_provider(self, v):
            self.set("ai_provider", v)
            here = "127.0.0.1" in self.base_var.get() or "localhost" in self.base_var.get()
            if v == "local":
                if not here:
                    self.base_var.set("http://127.0.0.1:11434/v1")
                if self.model_var.get() in ("", "bytebot"):
                    self.model_var.set("qwen2.5-coder:7b")
            elif v == "custom" and here:
                self.base_var.set("")
                self.model_var.set("")
            self.update_ai_view()
            if v == "builtin":
                self.push_ai()
                self.builtin_autostart()
            else:
                self.builtin.stop()

        def builtin_say(self, text, ok=False):
            self.builtin_status, self.builtin_ready = text, ok
            self.ui(lambda: self.cfg["ai_provider"] == "builtin" and self.show_ai_info())

        def on_size(self, v):
            self.set("builtin_size", v)
            self.builtin.stop()
            self.builtin_ready = False
            self.builtin_say("Model changed. Press Download & start.")

        def builtin_autostart(self):
            if STUDENT or self.cfg["ai_provider"] != "builtin":
                return
            mp = self.builtin.model_path(self.cfg["builtin_size"])
            if self.builtin.engine_exe() and mp and os.path.exists(mp):
                self.run_builtin(False)

        def run_builtin(self, download):
            if self.builtin_busy:
                return
            self.builtin_busy = True
            size = self.cfg["builtin_size"]

            def work():
                try:
                    if download:
                        exe = self.builtin.ensure_engine(self.builtin_say)
                        model = self.builtin.ensure_model(size, self.builtin_say)
                    else:
                        exe, model = self.builtin.engine_exe(), self.builtin.model_path(size)
                    self.builtin.start(exe, model, self.builtin_say)
                    self.builtin_say("Built-in AI is running on this PC: %s. Synced to the browser extension and VS Code." % BUILTIN_MODELS[size][0], True)
                except Exception as e:
                    self.builtin_say("Built-in AI failed: %s" % e)
                finally:
                    self.builtin_busy = False
            self.builtin_say("Starting...")
            threading.Thread(target=work, daemon=True).start()

