def build_vsix():
    """Bundled VS Code extension -> .vsix file (no vsce / npm needed)."""
    os.makedirs(VSC_DIR, exist_ok=True)
    out = os.path.join(VSC_DIR, "bytebot-vscode-%s.vsix" % VSC_VERSION)
    with zipfile.ZipFile(io.BytesIO(base64.b64decode(VSC_ZIP_B64))) as src, zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("[Content_Types].xml", _VSC_TYPES)
        z.writestr("extension.vsixmanifest", _VSC_MANIFEST % VSC_VERSION)
        for name in src.namelist():
            if not name.endswith("/"):
                z.writestr("extension/" + name, src.read(name))
    return out


def install_vscode():
    """Install into VS Code. Returns (ok, message). Tries the 'code' CLI first, then the extensions folder."""
    try:
        vsix = build_vsix()
    except Exception as e:
        return False, "Could not build the extension: %s" % e
    try:
        r = subprocess.run('code --install-extension "%s" --force' % vsix, shell=True, capture_output=True, text=True, timeout=120,
                           creationflags=0x08000000 if IS_WIN else 0)
        if r.returncode == 0:
            return True, "Installed in VS Code. Reload VS Code (Ctrl+Shift+P, 'Reload Window'), then click the ByteBot icon in the sidebar."
    except Exception:
        pass
    try:   # fallback: drop the extension straight into VS Code's extensions folder
        base = os.path.join(os.path.expanduser("~"), ".vscode", "extensions")
        os.makedirs(base, exist_ok=True)
        for d in os.listdir(base):
            if d.startswith("bytebot.bytebot-vscode-"):
                shutil.rmtree(os.path.join(base, d), ignore_errors=True)
        dest = os.path.join(base, "bytebot.bytebot-vscode-%s" % VSC_VERSION)
        with zipfile.ZipFile(io.BytesIO(base64.b64decode(VSC_ZIP_B64))) as z:
            z.extractall(dest)
        return True, "Copied into your VS Code extensions folder. Fully restart VS Code, then click the ByteBot icon in the sidebar."
    except Exception as e:
        return False, "Could not install automatically (%s). In VS Code: Extensions, ... menu, Install from VSIX, and pick:\n%s" % (e, vsix)


def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def save_json(path, data):
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f)
    except Exception:
        pass


def lines(text):
    return [x.strip() for x in text.splitlines() if x.strip() and not x.strip().startswith("#")]


def local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("10.255.255.255", 1))   # koi packet nahi jata, sirf route dekhta hai
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"


