        # ---- session flow
        def start(self):
            if self.focus.active():
                return
            now = time.time()
            mins = self.cfg["mins"]
            self.begin({"active": True, "startedAt": now, "endsAt": now + mins * 60, "mins": mins,
                        "hard": self.cfg["mode"] == "hard", "desktop": True, "browser": True, "ytlock": True,
                        "allow": self.cfg["allow"]})

        def begin(self, st, resumed=False):
            self.focus.begin(st)
            self.last_blocked = 0
            self.root.iconify()
            self.comp.show(True)
            self.tick()

        def tick(self):
            if not self.focus.active():
                return
            if self.focus.left() <= 0:
                return self.finish(True)
            self.focus.tick()
            if self.focus.blocked != self.last_blocked:
                self.last_blocked = self.focus.blocked
                self.comp.notify()
            self.comp.update()
            self.root.after(400, self.tick)

        def ask_stop(self):
            if not self.focus.active():
                return
            d = tk.Toplevel(self.root)
            d.title("Stop focus?")
            d.configure(bg=SURF)
            d.attributes("-topmost", True)
            d.geometry("420x230+%d+%d" % ((self.root.winfo_screenwidth() - 420) // 2, (self.root.winfo_screenheight() - 230) // 2))
            self.focus.finishing = True
            label(d, "Stop this focus session?", 15, TXT, True).pack(anchor="w", padx=24, pady=(22, 4))
            label(d, "Type this sentence to confirm:", 10, MUT).pack(anchor="w", padx=24)
            label(d, EXIT_PHRASE, 11, ACC_H, True).pack(anchor="w", padx=24, pady=(2, 8))
            var = tk.StringVar()
            e = entry(d, var, 40)
            e.pack(fill="x", padx=24, ipady=6)
            msg = label(d, "", 9, BAD)
            msg.pack(anchor="w", padx=24, pady=(6, 0))

            def close():
                self.focus.finishing = False
                d.destroy()

            def ok(_ev=None):
                if var.get().strip() == EXIT_PHRASE:
                    close()
                    self.finish(False)
                else:
                    msg.config(text="That doesn't match. Type the sentence exactly.")
            e.bind("<Return>", ok)
            d.protocol("WM_DELETE_WINDOW", close)
            row = tk.Frame(d, bg=SURF)
            row.pack(anchor="e", padx=24, pady=14)
            Btn(row, "Keep focusing", close, "ghost", height=38).pack(side="left", padx=8)
            Btn(row, "Stop focus", ok, "danger", height=38).pack(side="left")
            d.after(120, lambda: (d.focus_force(), e.focus_force()))

        def finish(self, done):
            self.focus.end(done)
            if done:
                try:
                    import winsound
                    winsound.MessageBeep()
                except Exception:
                    pass
            self.root.deiconify()
            self.root.lift()
            self.show_page("focus")
            self.refresh_idle()
            self.update_stats()
            self.comp.update()

