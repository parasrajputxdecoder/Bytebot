def hex_rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def blend(a, b, t):
    ra, rb = hex_rgb(a), hex_rgb(b)
    return "#%02x%02x%02x" % tuple(int(ra[i] + (rb[i] - ra[i]) * t) for i in range(3))


def fnt(size, bold=False):
    return (FONT, size, "bold" if bold else "normal")


def run_ui():
    import tkinter as tk
    import tkinter.font as tkfont
    from tkinter import messagebox, ttk

    KEY = "#010203"   # Windows transparent colour-key (rounded corners of the overlay)
    _fonts = {}

    def tw(text, size, bold=False):
        k = (size, bold)
        if k not in _fonts:
            _fonts[k] = tkfont.Font(family=FONT, size=size, weight="bold" if bold else "normal")
        return _fonts[k].measure(text)

    def rr(c, x1, y1, x2, y2, r, **kw):
        pts = [x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r, x2, y2 - r, x2, y2, x2 - r, y2, x1 + r, y2,
               x1, y2, x1, y2 - r, x1, y1 + r, x1, y1]
        return c.create_polygon(pts, smooth=True, **kw)

    def label(parent, text, size=10, color=TXT, bold=False, **kw):
        return tk.Label(parent, text=text, bg=parent["bg"], fg=color, font=fnt(size, bold), **kw)

    def card(parent, **kw):
        return tk.Frame(parent, bg=SURF, highlightthickness=1, highlightbackground=LINE, highlightcolor=LINE, **kw)

    def entry(parent, var, width=14):
        return tk.Entry(parent, textvariable=var, width=width, bg=SURF2, fg=TXT, insertbackground=TXT, relief="flat",
                        font=fnt(10), highlightthickness=1, highlightbackground=LINE, highlightcolor=ACC)

    def textbox(parent, value, height):
        t = tk.Text(parent, height=height, bg=SURF2, fg=TXT, insertbackground=TXT, relief="flat", font=("Consolas", 10),
                    padx=10, pady=8, highlightthickness=1, highlightbackground=LINE, highlightcolor=ACC, wrap="none")
        t.insert("1.0", value)
        return t

    # ------------------------------------------------------------------ custom widgets
    class Btn(tk.Canvas):
        KINDS = {"primary": (ACC, ACC_H, "white", ""), "ghost": (SURF2, "#1D2748", TXT, LINE),
                 "danger": ("#B4233F", "#D12F4F", "white", ""), "success": ("#0E9F78", "#13B98C", "white", "")}

        def __init__(self, parent, text, command=None, kind="primary", width=None, height=40, size=10):
            w = width or tw(text, size, True) + 44
            super().__init__(parent, width=w, height=height, bg=parent["bg"], highlightthickness=0, cursor="hand2")
            self.text, self.cmd, self.kind, self.w, self.h, self.size, self.hover = text, command, kind, w, height, size, False
            self.draw()
            self.bind("<Enter>", lambda e: self.set_hover(True))
            self.bind("<Leave>", lambda e: self.set_hover(False))
            self.bind("<Button-1>", lambda e: self.cmd() if self.cmd else None)

        def draw(self):
            self.delete("all")
            base, hov, fg, line = self.KINDS[self.kind]
            rr(self, 1, 1, self.w - 1, self.h - 1, 13, fill=hov if self.hover else base, outline=line)
            self.create_text(self.w // 2, self.h // 2, text=self.text, fill=fg, font=fnt(self.size, True))

        def set_hover(self, v):
            self.hover = v
            self.draw()

        def set(self, text=None, kind=None):
            self.text = text or self.text
            self.kind = kind or self.kind
            self.draw()

    class Toggle(tk.Canvas):
        def __init__(self, parent, value=False, command=None):
            super().__init__(parent, width=52, height=28, bg=parent["bg"], highlightthickness=0, cursor="hand2")
            self.value, self.cmd, self.pos = bool(value), command, 1.0 if value else 0.0
            self.draw()
            self.bind("<Button-1>", lambda e: self.set(not self.value, True))

        def draw(self):
            self.delete("all")
            rr(self, 1, 1, 51, 27, 13, fill=blend("#2A3558", ACC, self.pos), outline="")
            x = 14 + 24 * self.pos
            self.create_oval(x - 10, 4, x + 10, 24, fill="white", outline="")

        def set(self, v, fire=False):
            self.value = bool(v)
            target = 1.0 if self.value else 0.0

            def step():
                if abs(self.pos - target) < 0.05:
                    self.pos = target
                    self.draw()
                    return
                self.pos += (target - self.pos) * 0.5
                self.draw()
                self.after(16, step)
            step()
            if fire and self.cmd:
                self.cmd(self.value)

    class Segment(tk.Canvas):
        def __init__(self, parent, options, value, command=None, seg_w=112, height=40):
            super().__init__(parent, width=seg_w * len(options), height=height, bg=parent["bg"], highlightthickness=0, cursor="hand2")
            self.options, self.value, self.cmd, self.sw, self.h = options, value, command, seg_w, height
            self.draw()
            self.bind("<Button-1>", self.click)

        def draw(self):
            self.delete("all")
            n = len(self.options)
            rr(self, 1, 1, self.sw * n - 1, self.h - 1, 13, fill=SURF2, outline=LINE)
            for i, (key, text) in enumerate(self.options):
                sel = key == self.value
                if sel:
                    rr(self, i * self.sw + 4, 4, (i + 1) * self.sw - 4, self.h - 4, 10, fill=ACC, outline="")
                self.create_text(i * self.sw + self.sw // 2, self.h // 2, text=text, fill="white" if sel else MUT, font=fnt(10, True))

        def click(self, e):
            i = max(0, min(len(self.options) - 1, e.x // self.sw))
            self.set(self.options[i][0], True)

        def set(self, value, fire=False):
            self.value = value
            self.draw()
            if fire and self.cmd:
                self.cmd(value)

    class Ring(tk.Canvas):
        def __init__(self, parent, size=220, width=14):
            super().__init__(parent, width=size, height=size, bg=parent["bg"], highlightthickness=0)
            self.size, self.rw = size, width
            self.set(1.0, "00:00", "")

        def set(self, frac, big, small, color=ACC):
            self.delete("all")
            s, w = self.size, self.rw
            pad = w // 2 + 4
            self.create_oval(pad, pad, s - pad, s - pad, outline=LINE, width=w)
            if frac > 0.002:
                self.create_arc(pad, pad, s - pad, s - pad, start=90, extent=-min(359.9, 360 * frac), style="arc", outline=color, width=w)
            self.create_text(s // 2, s // 2 - 8, text=big, fill=TXT, font=fnt(int(s / 6.2), True))
            self.create_text(s // 2, s // 2 + s // 7, text=small, fill=MUT, font=fnt(10))


    CYAN, CYAN2, CORE = "#4DD9FF", "#1AA7D6", "#DFF9FF"

    def draw_reactor(c, cx, cy, r, ang, pulse=0.0, frac=None, core=True, bg=None):
        """Arc-reactor look: soft glow, tick ring, rotating segmented ring, inner rings and a glowing core."""
        bg = bg or c["bg"]
        for i in range(7):
            rr_ = r * (1.0 + 0.05 * i)
            c.create_oval(cx - rr_, cy - rr_, cx + rr_, cy + rr_, outline=blend(bg, CYAN2, 0.16 * (7 - i) / 7 * (0.65 + 0.35 * pulse)), width=3)
        c.create_oval(cx - r, cy - r, cx + r, cy + r, outline=CYAN2, width=2)
        for k in range(60):
            a = math.radians(k * 6 + ang * 0.15)
            major = k % 5 == 0
            r1, r2 = r * 0.92, r * (0.99 if major else 0.96)
            c.create_line(cx + r1 * math.cos(a), cy - r1 * math.sin(a), cx + r2 * math.cos(a), cy - r2 * math.sin(a),
                          fill=CYAN if major else blend(bg, CYAN2, 0.55), width=2 if major else 1)
        seg = max(4, int(r * 0.12))
        for k in range(10):
            c.create_arc(cx - r * 0.8, cy - r * 0.8, cx + r * 0.8, cy + r * 0.8, start=ang + k * 36, extent=26, style="arc", outline=CYAN, width=seg)
        c.create_oval(cx - r * 0.62, cy - r * 0.62, cx + r * 0.62, cy + r * 0.62, outline=CYAN2, width=2)
        if frac is not None:
            c.create_arc(cx - r * 0.7, cy - r * 0.7, cx + r * 0.7, cy + r * 0.7, start=90, extent=-min(359.9, 360 * max(frac, 0.002)),
                         style="arc", outline=CORE, width=max(3, int(r * 0.05)))
        if core:
            a0 = math.radians(-ang * 1.6)
            tri = []
            for k in range(3):
                a = a0 + k * 2.0944 + 1.5708
                tri += [cx + r * 0.44 * math.cos(a), cy - r * 0.44 * math.sin(a)]
            c.create_polygon(tri, outline=CYAN, fill="", width=2)
            cr = r * 0.2 * (1 + 0.12 * pulse)
            for i in range(5):
                gr = cr * (1.9 - 0.18 * i)
                c.create_oval(cx - gr, cy - gr, cx + gr, cy + gr, fill=blend(bg, CYAN, 0.12 + 0.17 * i), outline="")
            c.create_oval(cx - cr, cy - cr, cx + cr, cy + cr, fill=CORE, outline="")
        else:
            d = r * 0.56
            c.create_oval(cx - d, cy - d, cx + d, cy + d, fill=bg, outline=blend(bg, CYAN, 0.35), width=1)

    class ArcReactor(tk.Canvas):
        """Animated reactor ring with the time in the middle (Focus page)."""

        def __init__(self, parent, size=250):
            super().__init__(parent, width=size, height=size, bg=parent["bg"], highlightthickness=0)
            self.size, self.ang, self.t0 = size, 0.0, time.time()
            self.frac, self.big, self.small = 1.0, "00:00", ""
            self.after(60, self.tick)

        def set(self, frac, big, small, color=None):
            self.frac, self.big, self.small = frac, big, small

        def tick(self):
            if not self.winfo_exists():
                return
            if self.winfo_ismapped():
                self.ang = (self.ang + 1.8) % 360
                pulse = (math.sin((time.time() - self.t0) * 2.4) + 1) / 2
                s = self.size
                self.delete("all")
                draw_reactor(self, s / 2, s / 2, s * 0.4, self.ang, pulse, self.frac, core=False)
                self.create_text(s / 2, s / 2 - 6, text=self.big, fill=TXT, font=fnt(int(s / 10.5), True))
                self.create_text(s / 2, s / 2 + s / 11, text=self.small, fill=CYAN, font=fnt(9, True))
            self.after(50, self.tick)

    class Splash:
        """Boot screen: arc reactor spins up while the modules 'load', then the app fades in."""
        STEPS = ("Initializing arc core", "Calibrating focus engine", "Linking browser extension", "Linking VS Code", "Loading AI coach", "All systems online")

        def __init__(self, root, on_done, duration=3.0):
            self.root, self.on_done, self.dur = root, on_done, duration
            self.W, self.H = 560, 420
            w = tk.Toplevel(root)
            w.overrideredirect(True)
            w.attributes("-topmost", True)
            w.configure(bg=KEY)
            try:
                w.attributes("-transparentcolor", KEY)
            except tk.TclError:
                pass
            w.geometry("%dx%d+%d+%d" % (self.W, self.H, (root.winfo_screenwidth() - self.W) // 2, (root.winfo_screenheight() - self.H) // 2 - 20))
            self.cv = tk.Canvas(w, width=self.W, height=self.H, bg=KEY, highlightthickness=0)
            self.cv.pack()
            self.win, self.t0, self.ang, self.done = w, time.time(), 0.0, False
            self.step()

        def step(self):
            t = (time.time() - self.t0) / self.dur
            p = min(1.0, t)
            e = 1 - (1 - p) ** 2.2
            cv, W, H = self.cv, self.W, self.H
            cv.delete("all")
            self.ang = (self.ang + 2.5 + 7 * (1 - e)) % 360
            pulse = (math.sin(time.time() * 5) + 1) / 2 if p < 1 else 1.0
            rr(cv, 3, 3, W - 3, H - 3, 28, fill="#04070E", outline=blend("#04070E", CYAN2, 0.65), width=2)
            draw_reactor(cv, W / 2, 158, 100, self.ang, pulse, e, core=True, bg="#04070E")
            cv.create_text(W / 2, 292, text="B Y T E B O T", fill=TXT, font=fnt(21, True))
            cv.create_text(W / 2, 318, text="F O C U S   O S", fill=CYAN, font=fnt(9, True))
            idx = min(len(self.STEPS) - 1, int(e * len(self.STEPS)))
            for k in range(max(0, idx - 1), idx + 1):
                cur = k == idx and p < 1
                cv.create_text(W / 2, 346 + (k - max(0, idx - 1)) * 17, fill=CYAN if cur else MUT, font=("Consolas", 9),
                               text=("\u25B8 " if cur else "\u2713 ") + self.STEPS[k].upper())
            cv.create_line(60, 392, W - 60, 392, fill=LINE, width=3)
            cv.create_line(60, 392, 60 + (W - 120) * e, 392, fill=CYAN, width=3)
            cv.create_text(W - 60, 378, text="%d%%" % int(e * 100), anchor="e", fill=CYAN, font=("Consolas", 9, "bold"))
            if p < 1:
                self.root.after(25, self.step)
            elif not self.done:
                self.done = True
                self.on_done()
                self.fade(time.time())

        def fade(self, t0):
            t = (time.time() - t0) / 0.4
            if t >= 1:
                self.win.destroy()
                return
            try:
                self.win.attributes("-alpha", 1 - t)
            except tk.TclError:
                pass
            self.root.after(20, lambda: self.fade(t0))

    # ------------------------------------------------------------------ ByteBot companion overlay
    class Companion:
        """Always-on-top ByteBot overlay: rises out of the ground, auto-docks to a screen edge after 5 s, slides out on hover."""
        W, H, HW = 316, 176, 30
        CW = W + HW

        def __init__(self, hub):
            self.hub, self.root = hub, hub.root
            self.win = self.cv = None
            self.shown = self.animating = self.dragging = self.need_leave = False
            self.state, self.side = "out", "right"
            self.state_key = None
            self.btn = None
            self.moved = False
            self.drag = (0, 0)
            self.last_act = self.last_lift = self.flash_until = 0.0

        def screen(self):
            sw, sh = self.root.winfo_screenwidth(), self.root.winfo_screenheight()
            return sw, sh, work_bottom(sh - 48)

        def out_x(self, sw):
            return sw - self.CW - 12 if self.side == "right" else 12

        def dock_x(self, sw):
            return sw - self.HW if self.side == "right" else -(self.CW - self.HW)

        def make_win(self):
            w = tk.Toplevel(self.root)
            w.withdraw()
            w.overrideredirect(True)
            w.attributes("-topmost", True)
            w.configure(bg=KEY)
            try:
                w.attributes("-transparentcolor", KEY)
            except tk.TclError:
                pass
            return w

        # ---- show / hide
        def show(self, animate=True):
            if self.shown or self.animating:
                return
            sw, sh, ground = self.screen()
            self.side, self.state = "right", "out"
            self.win = self.make_win()
            self.cv = tk.Canvas(self.win, width=self.CW, height=self.H, bg=KEY, highlightthickness=0)
            self.cv.pack()
            self.cv.bind("<ButtonPress-1>", self.press)
            self.cv.bind("<B1-Motion>", self.motion)
            self.cv.bind("<ButtonRelease-1>", self.release)
            self.pos = (self.out_x(sw), ground - self.H - 14)
            self.win.geometry("%dx%d+%d+%d" % (self.CW, self.H, self.pos[0], ground))
            self.state_key = None
            self.shown = True
            self.layout()
            if animate:
                self.emerge(sw, sh, ground)
            else:
                self.win.geometry("+%d+%d" % self.pos)
                self.win.deiconify()
                self.last_act = time.time()
            self.root.after(100, self.watch)

        def hide(self):
            if not self.shown or self.animating:
                return
            self.animating = True
            sw, sh, ground = self.screen()
            x, y0, t0 = self.win.winfo_x(), self.win.winfo_y(), time.time()

            def step():
                t = (time.time() - t0) / 0.35
                if t >= 1:
                    self.win.destroy()
                    self.win = self.cv = None
                    self.shown = self.animating = False
                    return
                self.win.geometry("+%d+%d" % (x, int(y0 + (ground - y0) * t * t)))
                try:
                    self.win.attributes("-alpha", 1 - t)
                except tk.TclError:
                    pass
                self.root.after(16, step)
            step()

        # ---- dig-out animation
        def emerge(self, sw, sh, ground):
            self.animating = True
            x, y_final = self.pos
            win = self.win
            win.geometry("%dx%d+%d+%d" % (self.CW, self.H, x, ground))
            try:
                win.attributes("-alpha", 0.0)
            except tk.TclError:
                pass
            win.deiconify()
            top, dw = ground - 80, self.CW + 100
            dh = max(130, sh - top)
            dirt = self.make_win()
            dirt.geometry("%dx%d+%d+%d" % (dw, dh, x - 50, top))
            dc = tk.Canvas(dirt, width=dw, height=dh, bg=KEY, highlightthickness=0)
            dc.pack()
            dirt.deiconify()
            dirt.lift()
            gy, cx = 80, dw // 2
            specks = [(random.randint(24, dw - 24), random.randint(gy + 6, dh - 4), random.randint(1, 3)) for _ in range(60)]
            parts, t0 = [], time.time()
            palette = ["#6b4423", "#835a32", "#4a2f1b", "#9a7048", "#5b3a22"]

            def ease(t):
                return 1 + 2.4 * (t - 1) ** 3 + 1.4 * (t - 1) ** 2

            def step():
                t = time.time() - t0
                hump = 30 * min(1.0, t / 0.4) if t < 1.5 else max(0.0, 30 * (1 - (t - 1.5) / 0.5))
                sink = 0 if t < 1.5 else int(min(1.0, (t - 1.5) / 0.5) * (dh - gy + 6))
                shake = random.randint(-2, 2) if t < 1.3 else 0
                dc.delete("all")
                base = gy + sink
                dc.create_rectangle(10, base, dw - 10, dh + sink + 4, fill="#4a2f1b", outline="")
                for sx, sy, sr in specks:
                    dc.create_oval(sx, sy + sink, sx + sr, sy + sink + sr, fill="#6b4423", outline="")
                if hump > 0.5:
                    pts = [10, base, cx - 130 + shake, base - hump * 0.25, cx - 75, base - hump * 0.7, cx - 25, base - hump * 0.95,
                           cx + shake, base - hump, cx + 25, base - hump * 0.95, cx + 75, base - hump * 0.7,
                           cx + 130, base - hump * 0.25, dw - 10, base]
                    dc.create_polygon(pts, smooth=True, fill="#5b3a22", outline="#3b2414", width=2)
                if 0.25 < t < 1.2:
                    for _ in range(4):
                        parts.append([cx + random.randint(-75, 75), base - hump, random.uniform(-3, 3),
                                      -random.uniform(4, 10), random.randint(2, 5), t, random.choice(palette)])
                alive = []
                for pt in parts:
                    pt[0] += pt[2]; pt[1] += pt[3]; pt[3] += 0.55
                    if t - pt[5] < 0.9 and pt[1] < base + 8:
                        r = pt[4] * (1 - (t - pt[5]) / 1.2)
                        dc.create_oval(pt[0] - r, pt[1] - r, pt[0] + r, pt[1] + r, fill=pt[6], outline="")
                        alive.append(pt)
                parts[:] = alive
                p = min(1.0, max(0.0, (t - 0.45) / 1.0))
                win.geometry("+%d+%d" % (x, int(ground + (y_final - ground) * ease(p))))
                try:
                    win.attributes("-alpha", min(1.0, p * 3))
                except tk.TclError:
                    pass
                if t < 2.0:
                    self.root.after(16, step)
                else:
                    dirt.destroy()
                    win.geometry("+%d+%d" % (x, y_final))
                    try:
                        win.attributes("-alpha", 1.0)
                    except tk.TclError:
                        pass
                    self.animating = False
                    self.state, self.last_act, self.state_key = "out", time.time(), None
                    self.update()
            step()

        # ---- auto-dock to the screen edge, hover to slide out
        def watch(self):
            if not self.shown or not self.win:
                return
            if not self.animating and self.state in ("out", "docked"):
                px, py = self.root.winfo_pointerxy()
                wx, wy = self.win.winfo_x(), self.win.winfo_y()
                inside = wx - 6 <= px <= wx + self.CW + 6 and wy - 6 <= py <= wy + self.H + 6
                now = time.time()
                if self.state == "out":
                    if inside or self.dragging or now < self.flash_until or self.hub.focus.finishing:
                        self.last_act = now
                    elif self.hub.cfg.get("autohide", True) and now - self.last_act > 5:
                        self.dock()
                else:
                    if not inside:
                        self.need_leave = False
                    elif not self.need_leave:
                        self.undock()
            self.root.after(100, self.watch)

        def slide(self, tx, final):
            if not self.win:
                return
            x0, y, t0 = self.win.winfo_x(), self.win.winfo_y(), time.time()
            self.state = "sliding"

            def step():
                if not self.win:
                    return
                p = min(1.0, (time.time() - t0) / 0.26)
                e = 1 - (1 - p) ** 3
                self.win.geometry("+%d+%d" % (int(x0 + (tx - x0) * e), y))
                if p < 1:
                    self.root.after(12, step)
                else:
                    self.state, self.last_act = final, time.time()
                    if final == "docked":
                        self.need_leave = True
            step()

        def dock(self):
            if self.state != "out" or not self.win:
                return
            sw, sh, ground = self.screen()
            side = "right" if self.win.winfo_x() + self.CW / 2 > sw / 2 else "left"
            if side != self.side:
                self.side, self.state_key = side, None
                self.layout()
            self.slide(self.dock_x(sw), "docked")

        def undock(self):
            if self.state == "docked":
                self.slide(self.out_x(self.screen()[0]), "out")

        def notify(self):
            self.flash_until = time.time() + 3
            self.undock()

        # ---- drawing
        def button(self, name, x1, y1, x2, y2, text, fill, hover, size=10):
            cv = self.cv
            poly = rr(cv, x1, y1, x2, y2, 11, fill=fill, outline="", tags=("btn:" + name,))
            cv.create_text((x1 + x2) // 2, (y1 + y2) // 2, text=text, fill="white", font=fnt(size, True), tags=("btn:" + name,))
            cv.tag_bind("btn:" + name, "<Enter>", lambda e: cv.itemconfig(poly, fill=hover))
            cv.tag_bind("btn:" + name, "<Leave>", lambda e: cv.itemconfig(poly, fill=fill))

        def layout(self):
            cv, hub, W, H, HW = self.cv, self.hub, self.W, self.H, self.HW
            cv.delete("all")
            right = self.side == "right"
            ox, hx = (HW if right else 0), (0 if right else W)
            f = hub.focus
            active = f.active()
            edge = ACC if active else LINE
            # dock handle (stays visible when the card is tucked away)
            rr(cv, hx + 2, 8, hx + HW - 2, H - 8, 13, fill=SURF, outline=edge, width=2, tags=("handle",))
            hc = hx + HW // 2
            cv.create_image(hc, 28, image=hub.logo_xs, tags=("handle",))
            self.h_dot = cv.create_oval(hc - 4, 52, hc + 4, 60, fill=OK if active else MUT, outline="", tags=("handle",))
            cv.create_line(hc, 74, hc, H - 34, fill=LINE, width=4, capstyle="round")
            self.h_bar = cv.create_line(hc, H - 34, hc, H - 34, fill=ACC, width=4, capstyle="round")
            cv.create_text(hc, H - 20, text="\u2039" if right else "\u203a", fill=MUT, font=fnt(13, True), tags=("handle",))
            # card
            rr(cv, ox + 4, 4, ox + W - 4, H - 4, 22, fill=SURF, outline=edge, width=2, tags=("card",))
            cv.create_image(ox + 16, 13, image=hub.logo_m, anchor="nw", tags=("card",))
            cv.create_text(ox + 56, 24, text="ByteBot", anchor="w", fill=TXT, font=fnt(12, True), tags=("card",))
            self.t_sub = cv.create_text(ox + 57, 41, text="", anchor="w", fill=MUT, font=fnt(8), tags=("card",))
            for name, cx_, glyph in (("dock", ox + W - 52, "\u2013"), ("hide", ox + W - 28, "\u2715")):
                cv.create_rectangle(cx_ - 12, 14, cx_ + 12, 38, fill=SURF, outline="", tags=("btn:" + name,))
                cv.create_text(cx_, 26, text=glyph, fill=MUT, font=fnt(11, True), tags=("btn:" + name,))
            # progress ring
            rcx, rcy, rr_ = ox + 66, 110, 40
            cv.create_oval(rcx - rr_, rcy - rr_, rcx + rr_, rcy + rr_, outline=LINE, width=7)
            self.r_arc = cv.create_arc(rcx - rr_, rcy - rr_, rcx + rr_, rcy + rr_, start=90, extent=-359.9, style="arc", outline=ACC, width=7)
            self.r_text = cv.create_text(rcx, rcy - 4, text="", fill=TXT, font=fnt(15, True))
            self.r_sub = cv.create_text(rcx, rcy + 16, text="", fill=MUT, font=fnt(8))
            rx1, rx2 = ox + 126, ox + W - 18
            if active:
                st = f.st
                self.t_mode = cv.create_text(rx1, 72, text="", anchor="w", fill=ACC_H, font=fnt(10, True))
                cv.create_text(rx1, 94, text="\u2713 Apps  \u2713 Browser  \u2713 YouTube", anchor="w", fill=OK, font=fnt(8))
                self.t_blk = cv.create_text(rx1, 113, text="", anchor="w", fill=TXT, font=fnt(9))
                self.button("stop", rx1, 128, rx2, 158, "\u25A0  Stop focus", "#B4233F", "#D12F4F")
            else:
                mins = hub.cfg["mins"]
                for name, x1, glyph in (("minus", rx1, "\u2212"), ("plus", rx2 - 28, "+")):
                    cv.create_oval(x1, 60, x1 + 28, 88, fill=SURF2, outline=LINE, tags=("btn:" + name,))
                    cv.create_text(x1 + 14, 74, text=glyph, fill=TXT, font=fnt(12, True), tags=("btn:" + name,))
                cv.create_text((rx1 + rx2) // 2, 74, text="%d min" % mins, fill=TXT, font=fnt(11, True))
                mode = hub.cfg["mode"]
                half = (rx2 - rx1 - 6) // 2
                for i, (key, text) in enumerate((("study", "Study"), ("hard", "Hard"))):
                    x1 = rx1 + i * (half + 6)
                    sel = mode == key
                    self.button(key, x1, 96, x1 + half, 118, text, ACC if sel else SURF2, ACC_H if sel else "#1D2748", 9)
                self.button("start", rx1, 128, rx2, 158, "\u25B6  Start focus", ACC, ACC_H)

        def update(self):
            if not self.shown or self.animating or not self.win:
                return
            hub, f = self.hub, self.hub.focus
            key = (f.active(), self.side, hub.cfg["mins"], hub.cfg["mode"])
            if key != self.state_key:
                self.state_key = key
                self.layout()
            now = time.time()
            if now - self.last_lift > 3 and self.state != "sliding":
                self.last_lift = now
                self.win.lift()
            cv = self.cv
            hc = (0 if self.side == "right" else self.W) + self.HW // 2
            if f.active():
                st = f.st
                total = max(1.0, st["endsAt"] - st["startedAt"])
                left = max(0.0, f.left())
                frac = left / total
                s = int(left)
                col = WARN if left < 60 else ACC
                cv.itemconfig(self.r_arc, extent=-min(359.9, 360 * max(frac, 0.001)), outline=col)
                cv.itemconfig(self.r_text, text="%02d:%02d" % (s // 60, s % 60))
                cv.itemconfig(self.r_sub, text="left")
                cv.itemconfig(self.t_sub, text="Focus is on", fill=OK)
                cv.itemconfig(self.t_mode, text=("HARD" if st.get("hard") else "STUDY") + "  \u00B7  full lock")
                cv.itemconfig(self.t_blk, text="Blocked  %d" % f.blocked)
                top, bot = 74, self.H - 34
                cv.coords(self.h_bar, hc, bot, hc, bot - (bot - top) * (1 - frac))
            else:
                cv.itemconfig(self.r_arc, extent=-359.9, outline=ACC)
                cv.itemconfig(self.r_text, text="%02d:00" % hub.cfg["mins"])
                cv.itemconfig(self.r_sub, text="ready")
                cv.itemconfig(self.t_sub, text="Browser %s   VS Code %s" % ("\u2713" if hub.bridge.linked() else "\u2014", "\u2713" if hub.bridge.linked("vscode") else "\u2014"), fill=MUT)

        # ---- mouse
        def press(self, e):
            tags = self.cv.gettags("current")
            self.btn = next((t[4:] for t in tags if t.startswith("btn:")), None)
            self.handle_hit = "handle" in tags
            self.drag = (e.x_root - self.win.winfo_x(), e.y_root - self.win.winfo_y())
            self.moved = False
            self.dragging = True

        def motion(self, e):
            if self.btn or self.state != "out":
                return
            self.moved = True
            self.win.geometry("+%d+%d" % (e.x_root - self.drag[0], e.y_root - self.drag[1]))

        def release(self, e):
            self.dragging = False
            self.last_act = time.time()
            if self.moved:
                return
            if self.btn:
                getattr(self, "do_" + self.btn)()
            elif self.handle_hit and self.state == "out":
                self.dock()

        def do_start(self): self.hub.start()
        def do_stop(self): self.hub.ask_stop()
        def do_hide(self): self.hide()
        def do_dock(self): self.dock()
        def do_minus(self): self.hub.set_mins(self.hub.cfg["mins"] - 5)
        def do_plus(self): self.hub.set_mins(self.hub.cfg["mins"] + 5)
        def do_study(self): self.hub.set_mode("study")
        def do_hard(self): self.hub.set_mode("hard")

    # ------------------------------------------------------------------ main window
    class Hub:
        def __init__(self, root):
            self.root = root
            root.title("ByteBot")
            root.configure(bg=BG)
            root.geometry("1160x760")
            root.minsize(1020, 700)
            root.option_add("*highlightThickness", 0)
            root.protocol("WM_DELETE_WINDOW", self.on_close)
            self.cfg = load_json(CFG_F, {})
            for k, v in DEFAULTS.items():
                self.cfg.setdefault(k, v)
            if not self.cfg.get("uid"):
                self.cfg["uid"] = secrets.token_hex(6)
            if STUDENT:   # student edition: joins the class AI server
                self.cfg.update(ai_provider="custom", ai_base=_P.get("base", ""), ai_model="bytebot", ai_key=_P.get("code", ""))
            save_json(CFG_F, self.cfg)
            ensure_extension()
            self.last_blocked = 0
            self.ui_q = queue.Queue()   # worker threads hand UI updates to the main thread through this
            self.logo = tk.PhotoImage(data=LOGO_B64)
            self.logo_s, self.logo_m, self.logo_xs = self.logo.subsample(2), self.logo.subsample(3), self.logo.subsample(4)
            try:
                root.iconphoto(True, self.logo_s)
            except tk.TclError:
                pass
            self.bridge = Bridge()
            self.bridge_ok = self.bridge.start()
            self.builtin = BuiltinAI()
            self.builtin_status, self.builtin_ready, self.builtin_busy = "", False, False
            self.cls = None if STUDENT else ClassServer(self.upstream_cfg)
            self.focus = Focus(self.bridge)
            self.style()
            self.comp = Companion(self)
            self.build_shell()
            self.pages = {}
            for key in ("focus", "class", "feedback", "ext", "settings"):
                self.pages[key] = tk.Frame(self.stage, bg=BG)
            self.build_focus()
            if not STUDENT:
                self.build_class()
            self.build_feedback()
            self.build_ext()
            self.build_settings()
            self.show_page("focus")
            self.push_cfg()
            self.push_ai()
            self.builtin_autostart()
            self.refresh_idle()
            if STUDENT and not self.cfg.get("consented"):
                root.after(900, self.ask_consent)
            if not STUDENT and self.cfg.get("class_on"):
                root.after(1200, lambda: self.set_class(True))
            st = load_json(STATE_F, None)
            if st and st.get("active"):
                if time.time() < st.get("endsAt", 0):
                    self.begin(st, resumed=True)
                else:
                    self.focus.st = st
                    self.finish(True)
            elif self.cfg["overlay_auto"]:
                root.after(800, lambda: self.comp.show(True))
            root.after(100, self.drain_ui)
            root.after(1000, self.refresh)
            resuming = bool(st and st.get("active") and time.time() < st.get("endsAt", 0))
            if self.cfg.get("splash", True) and not resuming and os.environ.get("BYTEBOT_NOSPLASH") != "1":
                root.withdraw()
                Splash(root, self.after_splash)

        def after_splash(self):
            self.root.attributes("-alpha", 0.0)
            self.root.deiconify()
            t0 = time.time()

            def fade():
                t = min(1.0, (time.time() - t0) / 0.45)
                try:
                    self.root.attributes("-alpha", t)
                except tk.TclError:
                    return
                if t < 1:
                    self.root.after(20, fade)
            fade()

        # ---- shared
        def ui(self, fn):
            self.ui_q.put(fn)

        def drain_ui(self):
            try:
                while True:
                    self.ui_q.get_nowait()()
            except queue.Empty:
                pass
            except Exception:
                pass
            self.root.after(100, self.drain_ui)

