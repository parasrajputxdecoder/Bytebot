def parse_allow(text):
    exes, titles = set(), []
    for s in lines(text.lower()):
        if s.startswith("title:"):
            if s[6:].strip():
                titles.append(s[6:].strip())
        else:
            exes.add(s if s.endswith(".exe") else s + ".exe")
    return exes, titles


def violation(hwnd, exes, titles):
    """(exe, title) agar window allowed nahi; shaq ho to None (safe side)."""
    if not hwnd or not u32.IsWindowVisible(hwnd):
        return None
    pid = pid_of(hwnd)
    if pid == os.getpid():
        return None
    exe = exe_of(pid)
    if not exe or exe in SKIP:
        return None
    t = title_of(hwnd)
    if not t:
        return None
    if any(x in t.lower() for x in titles):
        return None
    if exe in NOKILL:
        return (exe, t) if wtext(u32.GetClassNameW, hwnd) == "ApplicationFrameWindow" else None
    return None if exe in exes else (exe, t)


# ----------------------------------------------------------------------------- Extension bridge
class Bridge:
    """127.0.0.1:8777 par ByteBot extension ko focus state + config deta hai (sirf read-only GET)."""

    def __init__(self):
        self.lock = threading.Lock()
        self.focus = {"active": False}
        self.cfg = None
        self.ai_key = ""
        self.ai = None
        self.ctx = {"problem": None, "code": None}   # what the browser and VS Code currently have open (memory only)
        self.polls = {}   # client name (chrome / vscode) -> last poll time
        self.httpd = None

    def set_focus(self, st):
        with self.lock:
            if st:
                self.focus = {"active": True, "id": int(st["startedAt"] * 1000), "level": "hard" if st.get("hard") else "study",
                              "mins": st["mins"], "endsAt": int(st["endsAt"] * 1000)}
            else:
                self.focus = {"active": False}

    def set_ctx(self, d):
        """The browser extension reports the open problem, the VS Code extension reports the open file."""
        now = int(time.time() * 1000)
        kind = d.get("kind")
        if kind == "problem":
            v = {"key": str(d.get("key", ""))[:160], "title": str(d.get("title", ""))[:120], "platform": str(d.get("platform", ""))[:30],
                 "url": str(d.get("url", ""))[:300], "statement": str(d.get("statement", ""))[:6000], "ts": now}
        elif kind == "code":
            v = {"file": str(d.get("file", ""))[:80], "lang": str(d.get("lang", ""))[:24], "code": str(d.get("code", ""))[:14000],
                 "diag": [str(x)[:160] for x in (d.get("diag") or [])][:8], "ts": now}
        else:
            return False
        with self.lock:
            self.ctx[kind] = v
        return True

    def set_ai(self, ai):
        with self.lock:
            self.ai = ai

    def set_key(self, key):
        with self.lock:
            self.ai_key = key or ""

    def set_cfg(self, cfg):
        with self.lock:
            self.cfg = cfg

    def snapshot(self):
        with self.lock:
            return {"focus": dict(self.focus), "cfg": self.cfg, "ext_version": EXT_VERSION, "ai_key": self.ai_key, "ai": self.ai, "ctx": dict(self.ctx)}

    def start(self):
        bridge = self

        class H(BaseHTTPRequestHandler):
            def log_message(self, *a): pass

            def do_POST(self):
                # needs the custom header (so web pages cannot send it) and a local Host (blocks DNS rebinding)
                if (self.headers.get("Host", "").split(":")[0] not in ("127.0.0.1", "localhost") or self.headers.get("X-ByteBot") != "1"
                        or urlsplit(self.path).path != "/ext/context"):
                    self.send_response(403); self.end_headers(); return
                try:
                    n = int(self.headers.get("Content-Length", "0"))
                    if n > 200000:
                        raise ValueError
                    ok = bridge.set_ctx(json.loads(self.rfile.read(n) or b"{}"))
                except Exception:
                    ok = False
                self.send_response(200 if ok else 400)
                self.send_header("Content-Length", "0")
                self.end_headers()

            def do_GET(self):
                u = urlsplit(self.path)
                if self.headers.get("Host", "").split(":")[0] not in ("127.0.0.1", "localhost"):
                    self.send_response(403); self.end_headers(); return   # blocks DNS-rebinding from web pages
                if u.path != "/ext/state":
                    self.send_response(404); self.end_headers(); return
                bridge.polls[(parse_qs(u.query).get("c") or ["chrome"])[0][:12]] = time.time()
                b = json.dumps(bridge.snapshot()).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(b)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(b)

        try:
            self.httpd = ThreadingHTTPServer(("127.0.0.1", HUB_PORT), H)
            threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
            return True
        except OSError:
            return False   # port busy (Hub ka dusra instance chal raha hoga)

    def linked(self, client="chrome"):
        return time.time() - self.polls.get(client, 0.0) < 40


# ----------------------------------------------------------------------------- Desktop focus
class Focus:
    def __init__(self, bridge):
        self.b = bridge
        self.st = None
        self.exes, self.titles, self.strikes, self.last_sweep = set(), [], {}, 0
        self.last_yt, self.hits = 0, 0
        self.blocked, self.last_block, self.finishing = 0, 0, False

    def active(self):
        return bool(self.st and self.st.get("active"))

    def begin(self, st):
        self.st = st
        self.exes, self.titles = parse_allow(st.get("allow", ""))
        self.strikes = {}
        self.hits = 0
        self.blocked = 0
        self.finishing = False
        save_json(STATE_F, st)
        if st.get("browser"):
            self.b.set_focus(st)
        if st.get("desktop"):
            self.sweep()

    def left(self):
        return self.st["endsAt"] - time.time()

    def tick(self):
        if not self.st:
            return
        try:
            fg = u32.GetForegroundWindow()
            if self.st.get("ytlock"):
                self.yt_check(fg)
            if self.st.get("desktop"):
                self.enforce(fg)
                if time.time() - self.last_sweep > 3:
                    self.sweep()
        except Exception:
            pass

    def yt_check(self, hwnd):
        """Extension ke bina YouTube lock: browser ki foreground window ka title dekhta hai (incognito me bhi)."""
        if not hwnd or time.time() - self.last_yt < 1.5:
            return
        if self.st.get("browser") and self.b.linked():
            return   # extension chal raha hai, wo channel-wise handle karta hai
        if exe_of(pid_of(hwnd)) not in BROWSERS:
            return
        t = title_of(hwnd)
        if not is_youtube_title(t):
            return
        if not self.st.get("hard") and any(x in t.lower() for x in self.titles):
            return   # study mode: allowed shabd wala video chalne do
        self.last_yt = time.time()
        self.hits += 1
        self.blocked += 1
        close_tab(hwnd)

    def enforce(self, hwnd):
        v = violation(hwnd, self.exes, self.titles)
        if not v:
            return
        exe = v[0]
        if time.time() - self.last_block > 1:
            self.last_block = time.time()
            self.blocked += 1
        if self.st.get("hard") and exe not in NOKILL:
            n, last = self.strikes.get(exe, (0, 0))
            n = 1 if time.time() - last > 20 else n + 1
            self.strikes[exe] = (n, time.time())
            if n <= 2:
                u32.PostMessageW(hwnd, 0x0010, 0, 0)   # WM_CLOSE: app khud save prompt dikha sakta hai
            else:
                subprocess.Popen(["taskkill", "/F", "/PID", str(pid_of(hwnd))], creationflags=0x08000000,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.strikes[exe] = (0, time.time())
        u32.ShowWindow(hwnd, 6)

    def sweep(self):
        self.last_sweep = time.time()
        found = []

        def cb(hwnd, _):
            try:
                if violation(hwnd, self.exes, self.titles):
                    found.append(hwnd)
            except Exception:
                pass
            return True

        u32.EnumWindows(ENUM(cb), 0)
        for h in found:
            u32.ShowWindow(h, 6)

    def end(self, done):
        st = self.st or load_json(STATE_F, {}) or {}
        if st.get("active"):
            mins = max(0, round((min(time.time(), st["endsAt"]) - st["startedAt"]) / 60))
            log = load_json(LOG_F, [])
            log.append({"ts": st["startedAt"], "mins": mins, "hard": st.get("hard"), "done": bool(done)})
            save_json(LOG_F, log[-80:])
        save_json(STATE_F, {"active": False})
        self.b.set_focus(None)
        self.st = None


