                return
            v, k = c["ai_provider"], c.get("ai_key", "")
            if v == "cloud":
                self.key_info.config(text=("Saved (%s\u2026%s). Synced to the browser extension and VS Code." % (k[:4], k[-3:])) if k
                                     else "No key yet. Paste one and press Save.", fg=OK if k else WARN)
            elif v == "builtin":
                self.key_info.config(text=self.builtin_status or "Not set up yet. Choose a size and press Download & start.",
                                     fg=OK if self.builtin_ready else WARN)
            else:
                self.key_info.config(text="%s model '%s' at %s. Synced to the browser extension and VS Code." %
                                     ("Local" if v == "local" else "Custom", c["ai_model"], c["ai_base"]), fg=OK)

