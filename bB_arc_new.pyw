_YT_RE = re.compile(r"(^|\s-\s)youtube( music)?(\s-\s[^-]*){0,2}$")


def is_youtube_title(t):
    """'Video - YouTube - Brave', 'YouTube - Brave', '(3) YouTube'. 'YouTube downloader - GitHub' jaise page nahi."""
    tl = re.sub(r"^\(\d+\)\s*", "", t.lower().strip())
    return bool(_YT_RE.search(tl))


