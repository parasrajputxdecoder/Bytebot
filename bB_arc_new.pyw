                row = tk.Frame(inner, bg=SURF)
                row.pack(anchor="w")
                Btn(row, "Send feedback", self.send_feedback, "primary", height=40).pack(side="left")
                self.fb_status = label(row, "", 10, MUT)
                self.fb_status.pack(side="left", padx=14)
                return
            self.page_head(p, "Feedback", "What students sent from the Hub. Open a row to read it fully.")
            top = tk.Frame(p, bg=BG)
            top.pack(fill="x", pady=(0, 10))
            Btn(top, "Export CSV to Desktop", self.export_feedback, "ghost", height=38).pack(side="left")
            tc = card(p)
            tc.pack(fill="both", expand=True)
            self.fb_tree = ttk.Treeview(tc, columns=("time", "sid", "rating", "tool", "text"), show="headings", height=12)
            for k, t, wd in (("time", "When", 120), ("sid", "Student", 130), ("rating", "Rating", 70), ("tool", "From", 70), ("text", "Comment", 400)):
                self.fb_tree.heading(k, text=t, anchor="w")
                self.fb_tree.column(k, width=wd, anchor="w", stretch=(k == "text"))
            self.fb_tree.pack(fill="both", expand=True, padx=1, pady=1)
            self.fb_tree.bind("<Double-1>", self.fb_detail)
            self.fb_rows = {}

        def fill_feedback(self, rows):
            self.fb_tree.delete(*self.fb_tree.get_children())
            self.fb_rows = {}
            for ts, sid, tool, rating, text in rows:
                iid = self.fb_tree.insert("", "end", values=(time.strftime("%d %b  %H:%M", time.localtime(ts)), sid, "\u2605" * rating, tool,
                                                              (text or "").replace("\n", " ")[:120]))
                self.fb_rows[iid] = (ts, sid, tool, rating, text)

        def fb_detail(self, _e):
            sel = self.fb_tree.selection()
            r = self.fb_rows.get(sel[0]) if sel else None
            if r:
                messagebox.showinfo("Feedback from %s" % r[1], "%s\nRating: %d / 5   From: %s\n\n%s" % (
                    time.strftime("%d %b %Y  %H:%M", time.localtime(r[0])), r[3], r[2], r[4] or "(no comment)"))

        def export_feedback(self):
            out = os.path.join(os.path.expanduser("~"), "Desktop", "bytebot_feedback.csv")
            with open(out, "w", encoding="utf-8", newline="") as fh:
                w = csv.writer(fh)
                w.writerow(["time", "student", "from", "rating", "comment"])
                for ts, sid, tool, rating, text in self.cls.feedback(5000):
                    w.writerow([time.strftime("%Y-%m-%d %H:%M", time.localtime(ts)), sid, tool, rating, text])
            messagebox.showinfo("Exported", out)

        def send_feedback(self):
            text = self.fb_text.get("1.0", "end").strip()
            rating = int(self.fb_rating.value)
            self.fb_status.config(text="Sending\u2026", fg=MUT)

            def work():
                st, d = _post_json(_P.get("url", "") + "/feedback", {"rating": rating, "text": text, "tool": "hub"},
                                   {"Authorization": "Bearer " + _P.get("code", ""), "X-ByteBot-Id": self.cfg["uid"]}, 15)
                self.ui(lambda: done(st == 200, d))

            def done(ok, d):
                if ok:
                    self.fb_text.delete("1.0", "end")
                    self.fb_status.config(text="Thank you! Feedback sent.", fg=OK)
                else:
                    self.fb_status.config(text="Could not send: %s" % (_err(d, 0) if d else "no answer"), fg=BAD)
            threading.Thread(target=work, daemon=True).start()

        # ---- periodic
        def toggle_comp(self):
            if self.comp.shown:
                self.comp.hide()
            else:
                self.comp.show(True)

        def refresh(self):
            try:
                linked = self.bridge.linked()
                vlinked = self.bridge.linked("vscode")
                self.vsc_link.config(text="\u25CF  VS Code connected" if vlinked else "\u25CF  VS Code not connected", fg=OK if vlinked else WARN)
                if not self.bridge_ok:
                    self.link.config(text="Hub link off \u2014 port %d is busy" % HUB_PORT, fg=BAD)
                elif linked:
                    self.link.config(text="\u25CF  Browser extension connected", fg=OK)
                else:
                    self.link.config(text="\u25CF  Browser extension not connected", fg=WARN)
                for key, state in (("ext", linked), ("vsc", vlinked)):
                    if key in self.dots:
                        self.dots[key][0].config(fg=OK if state else MUT)
                self.update_live()
                if not STUDENT:
                    self.refresh_class()
                self.sum_btn.set("\u25BC  Hide ByteBot" if self.comp.shown else "\u25B2  Summon ByteBot")
                self.comp.update()
            except Exception:
                pass
            self.root.after(3000, self.refresh)

        def on_close(self):
            if self.focus.active():
                self.root.iconify()
                return
            if self.cls:
                self.cls.stop()
            self.builtin.stop()
            self.root.destroy()

    root = tk.Tk()
    Hub(root)
    root.mainloop()


if __name__ == "__main__":
    if not IS_WIN:
        print("ByteBot Hub sirf Windows ke liye hai.")
        sys.exit(1)
    run_ui()
