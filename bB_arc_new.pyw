def _err(d, st):
    e = d.get("error") if isinstance(d, dict) else None
    if e:
        return e.get("message", str(e)) if isinstance(e, dict) else str(e)
    return "AI service error %s" % st


def _http_json(url, body=None, headers=None, timeout=90):
    """(status, parsed json). status 0 = could not connect."""
    data = json.dumps(body).encode() if body is not None else None
    h = dict({"Content-Type": "application/json"} if body is not None else {}, **(headers or {}))
    req = urllib.request.Request(url, data, h)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, json.loads(r.read().decode("utf-8", "replace") or "{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read().decode("utf-8", "replace") or "{}")
        except Exception:
            return e.code, {}
    except Exception as e:
        return 0, {"error": {"message": str(e)}}


def _post_json(url, body, headers=None, timeout=90):
    return _http_json(url, body, headers, timeout)


def ask_upstream(up, system, messages):
    """up = {provider, key, base, model}. Returns (text, error)."""
    prov, key = up.get("provider", "cloud"), (up.get("key") or "").strip()
    if prov in ("local", "custom"):
        base = (up.get("base") or "").rstrip("/")
        if not base:
            return "", "No AI server address is set."
        h = {"Authorization": "Bearer " + key} if (prov == "custom" and key) else {}
        st, d = _post_json(base + "/chat/completions", {"model": up.get("model") or "bytebot", "stream": False, "max_tokens": 1000,
                                                       "messages": [{"role": "system", "content": system}] + messages}, h, 120)
        try:
            return d["choices"][0]["message"]["content"], ""
        except Exception:
            return "", _err(d, st)
    if not key:
        return "", "The class server has no AI key yet."
    if key.startswith("sk-ant"):
        st, d = _post_json(ANTHROPIC_URL, {"model": "claude-sonnet-5-5", "max_tokens": 1000, "system": system, "messages": messages},
                           {"x-api-key": key, "anthropic-version": "2023-06-01"})
        try:
            return "".join(b.get("text", "") for b in d["content"]), ""
        except Exception:
            return "", _err(d, st)
    last = ""
    for model in GEMINI_MODELS:
        st, d = _post_json(GEMINI_BASE + model + ":generateContent", {
            "systemInstruction": {"parts": [{"text": system}]},
            "contents": [{"role": "model" if m["role"] == "assistant" else "user", "parts": [{"text": m["content"]}]} for m in messages],
            "generationConfig": {"maxOutputTokens": 1000}}, {"x-goog-api-key": key})
        try:
            t = "".join(p.get("text", "") for p in d["candidates"][0]["content"]["parts"])
            if t:
                return t, ""
        except Exception:
            pass
        last = _err(d, st)
        if st in (0, 429, 500, 503, 404):
            time.sleep(1.2)
            continue
        break
    return "", last or "The AI service did not answer."


def test_engine(cfg):
    """Cheap connection test (lists models, costs no tokens). Returns (ok, message)."""
    prov, key = cfg.get("provider"), (cfg.get("key") or "").strip()
    if prov in ("local", "custom"):
        base = (cfg.get("base") or "").rstrip("/")
        if not base:
            return False, "Enter the server URL first."
        st, d = _http_json(base + "/models", None, {"Authorization": "Bearer " + key} if (prov == "custom" and key) else {}, 8)
        if st == 0:
            if prov == "local":
                return False, "Cannot reach the local model. Install Ollama (ollama.com), keep it running, then run: ollama pull %s" % (cfg.get("model") or "qwen2.5-coder:7b")
            return False, "Cannot reach %s. Check the address and your network." % base
        if st == 401:
            return False, "The server rejected the key / code."
        if st != 200:
            return False, "Server answered with error %s." % st
        ids = [m.get("id", "?") for m in (d.get("data") or [])][:6]
        if prov == "local" and not ids:
            return False, "Ollama is running but no model is installed. Run: ollama pull %s" % (cfg.get("model") or "qwen2.5-coder:7b")
        return True, "Connected. Models: %s" % (", ".join(ids) or "(server did not list any)")
    if not key:
        return False, "Paste a key first."
    if key.startswith("sk-ant"):
        st, d = _http_json(ANTHROPIC_URL.replace("/messages", "/models"), None, {"x-api-key": key, "anthropic-version": "2023-06-01"}, 12)
    else:
        st, d = _http_json(GEMINI_BASE.rstrip("/"), None, {"x-goog-api-key": key}, 12)
    if st == 200:
        return True, "Key works."
    if st in (400, 401, 403):
        return False, "That key was rejected. Check that you copied all of it."
    return False, "Could not verify the key (%s)." % _err(d, st)


