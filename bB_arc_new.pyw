                                 "strict": bool(c["strict"]), "restricted": bool(c["restricted"])})

        def age_text(self, ts):
            sec = max(0, int(time.time() - ts / 1000))
            return ("%ds ago" % sec) if sec < 90 else ("%d min ago" % (sec // 60))

        def update_live(self):
            c = self.bridge.snapshot().get("ctx") or {}
            pr, co = c.get("problem"), c.get("code")
            fresh = lambda v: v and time.time() - v["ts"] / 1000 < 15 * 60
            self.live_pb.config(text=("\u25CF  Browser problem:  %s  (%s)  \u00b7  %s" % (pr["title"], pr["platform"], self.age_text(pr["ts"]))) if pr
                                else "\u25CB  Browser problem:  none yet. Open a problem on a coding site.", fg=OK if fresh(pr) else MUT)
            self.live_vs.config(text=("\u25CF  VS Code file:  %s  (%s)  \u00b7  %s" % (co["file"], co["lang"], self.age_text(co["ts"]))) if co
                                else "\u25CB  VS Code file:  none yet. Open a code file in VS Code.", fg=OK if fresh(co) else MUT)

        def install_vsc(self):
            self.vsc_btn.set("Installing\u2026")

            def work():
                ok, msg = install_vscode()
                self.ui(lambda: done(ok, msg))

            def done(ok, msg):
                self.vsc_btn.set("Install in VS Code")
                (messagebox.showinfo if ok else messagebox.showwarning)("ByteBot for VS Code", msg)
            threading.Thread(target=work, daemon=True).start()

