LLAMA_FALLBACK = ("b11719", "llama-b11719-bin-win-cpu-x64.zip")   # known-good build if GitHub cannot be read


def _get_text(url, timeout=25):
    req = urllib.request.Request(url, headers={"User-Agent": "ByteBotHub"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def find_engine_url():
    """(url, file name) of the Windows CPU build of llama.cpp. GitHub's 'latest' release can be a source-only tag
    with no binaries, so look through the newest bNNNN tags instead (plain web pages: no API, no rate limit)."""
    base = "https://github.com/ggml-org/llama.cpp/releases/"
    try:
        tags = sorted({int(t) for t in re.findall(r"/releases/tag/b(\d+)", _get_text(base))}, reverse=True)[:6]
        for n in tags:
            tag = "b%d" % n
            m = re.search(r"/releases/download/%s/(llama-%s-bin-win-cpu-x64\.zip)" % (tag, tag), _get_text(base + "expanded_assets/" + tag))
            if m:
                return base + "download/%s/%s" % (tag, m.group(1)), m.group(1)
    except Exception:
        pass
    tag, name = LLAMA_FALLBACK
    return base + "download/%s/%s" % (tag, name), name


def pick_llama_asset(assets):
    """Choose the plain CPU Windows build of llama.cpp from a GitHub release's asset list (works on every PC)."""
    bad = ("cuda", "cudart", "vulkan", "hip", "sycl", "opencl", "arm", "rocm")
    ok = [a for a in assets if a["name"].lower().endswith(".zip") and "win" in a["name"].lower()
          and "x64" in a["name"].lower() and not any(b in a["name"].lower() for b in bad)]
    for key in ("cpu", "avx2"):
        for a in ok:
            if key in a["name"].lower():
                return a
    return ok[0] if ok else None


ENGINE_LOG = os.path.join(DIR, "engine.log")


def ram_mb():
    """(total, free) physical RAM in MB on Windows, or None."""
    try:
        import ctypes

        class MS(ctypes.Structure):
            _fields_ = [("dwLength", ctypes.c_ulong), ("dwMemoryLoad", ctypes.c_ulong), ("ullTotalPhys", ctypes.c_ulonglong),
                        ("ullAvailPhys", ctypes.c_ulonglong), ("ullTotalPageFile", ctypes.c_ulonglong),
                        ("ullAvailPageFile", ctypes.c_ulonglong), ("ullTotalVirtual", ctypes.c_ulonglong),
                        ("ullAvailVirtual", ctypes.c_ulonglong), ("sullAvailExtendedVirtual", ctypes.c_ulonglong)]
        m = MS()
        m.dwLength = ctypes.sizeof(MS)
        ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(m))
        return m.ullTotalPhys >> 20, m.ullAvailPhys >> 20
    except Exception:
        return None


def log_tail(n=4, width=420):
    """The lines of the engine log that explain a failed start (errors first, else the last lines)."""
    try:
        with open(ENGINE_LOG, "r", encoding="utf-8", errors="replace") as f:
            lines = [l.strip() for l in f.read().splitlines() if l.strip()]
        keys = ("error", "failed", "invalid", "corrupt", "unable", "cannot", "not enough", "alloc", "magic", "unknown", "out of")
        bad = [l for l in lines if any(k in l.lower() for k in keys)]
        pick = bad[:3] if bad else lines[-n:]
        return " | ".join(pick)[:width]
    except Exception:
        return ""


def is_gguf(path):
    try:
        with open(path, "rb") as f:
            return f.read(4) == b"GGUF"
    except OSError:
        return False


def remote_size(url):
    """Size of the file online in bytes, or None (offline / unknown): used to spot a half-downloaded model."""
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "ByteBotHub", "Range": "bytes=0-0"})
        with urllib.request.urlopen(req, timeout=15) as r:
            cr = r.headers.get("Content-Range", "")
            if "/" in cr:
                return int(cr.rsplit("/", 1)[1])
            return int(r.headers.get("Content-Length") or 0) or None
    except Exception:
        return None


class BuiltinAI:
    """Runs llama-server.exe (llama.cpp) on 127.0.0.1 with a GGUF model. It speaks the OpenAI chat API, so the Hub,
    the browser extension and VS Code use it exactly like the 'Local model' option, but nothing else is installed."""

    def __init__(self):
        self.proc = None

    def model_path(self, size):
        if size == "custom":
            try:
                fs = [os.path.join(MODEL_DIR, f) for f in os.listdir(MODEL_DIR) if f.lower().endswith(".gguf")]
            except OSError:
                fs = []
            return max(fs, key=os.path.getmtime) if fs else None
        return os.path.join(MODEL_DIR, BUILTIN_MODELS[size][1])

    def engine_exe(self):
        for root, _d, files in os.walk(ENGINE_DIR):
            if "llama-server.exe" in files:
                return os.path.join(root, "llama-server.exe")
        return None

    @staticmethod
    def alive():
        return _http_json("http://127.0.0.1:%d/health" % BUILTIN_PORT, None, None, 2)[0] == 200

    @staticmethod
    def _download(url, dest, say, what):
        part = dest + ".part"
        req = urllib.request.Request(url, headers={"User-Agent": "ByteBotHub"})
        with urllib.request.urlopen(req, timeout=60) as r, open(part, "wb") as f:
            total, got, last = int(r.headers.get("Content-Length") or 0), 0, 0.0
            while True:
                b = r.read(1 << 20)
                if not b:
                    break
                f.write(b)
                got += len(b)
                if time.time() - last > 0.5:
                    last = time.time()
                    say("Downloading %s: %s" % (what, ("%d%% (%d of %d MB)" % (got * 100 // total, got >> 20, total >> 20)) if total else "%d MB" % (got >> 20)))
        if total and got != total:
            try:
                os.remove(part)
            except OSError:
                pass
            raise RuntimeError("the download stopped early (%d of %d MB). Check your internet and press the button again." % (got >> 20, total >> 20))
        os.replace(part, dest)

    def ensure_engine(self, say):
        exe = self.engine_exe()
        if exe:
            return exe
        say("Finding the AI engine (llama.cpp)...")
        url, name = find_engine_url()
        os.makedirs(ENGINE_DIR, exist_ok=True)
        z = os.path.join(ENGINE_DIR, name)
        self._download(url, z, say, "AI engine")
        with zipfile.ZipFile(z) as zf:
            zf.extractall(ENGINE_DIR)
        os.remove(z)
        exe = self.engine_exe()
        if not exe:
            raise RuntimeError("llama-server.exe was not inside the downloaded engine.")
        return exe

    def ensure_model(self, size, say):
        os.makedirs(MODEL_DIR, exist_ok=True)
        path = self.model_path(size)
        if size == "custom":
            if not path:
                raise RuntimeError("put any .gguf file into %s and press the button again." % MODEL_DIR)
            return path
        url = BUILTIN_MODELS[size][2]
        good = os.path.exists(path) and os.path.getsize(path) > 100 << 20 and is_gguf(path)
        if good:
            want = remote_size(url)   # None when offline: then trust the file
            if want and want != os.path.getsize(path):
                good = False
        if not good:
            if os.path.exists(path):
                say("The saved model file is incomplete. Downloading it again...")
                os.remove(path)
            self._download(url, path, say, "model")
            if not is_gguf(path):
                os.remove(path)
                raise RuntimeError("the downloaded file is not a valid model. Press the button to try again.")
        return path

    def start(self, exe, model, say):
        if self.alive():
            return
        self.stop()
        cmd = [exe, "-m", model, "--host", "127.0.0.1", "--port", str(BUILTIN_PORT), "-c", "4096", "-np", "1"]
        logf = open(ENGINE_LOG, "wb")
        self.proc = subprocess.Popen(cmd, cwd=os.path.dirname(exe), stdout=logf, stderr=subprocess.STDOUT,
                                     creationflags=0x08000000)   # no console window
        logf.close()
        say("Loading the model (the first time can take a minute)...")
        for _ in range(180):
            if self.proc.poll() is not None:
                r = ram_mb()
                raise RuntimeError("the engine closed (exit code %s). %sEngine said: %s  (full log: %s)" % (
                    self.proc.returncode, ("RAM total %d MB, free %d MB. " % r) if r else "", log_tail() or "nothing", ENGINE_LOG))
            if self.alive():
                return
            time.sleep(1)
        raise RuntimeError("the engine did not get ready in time.")

    def stop(self):
        p, self.proc = self.proc, None
        if p and p.poll() is None:
            p.terminate()
            try:
                p.wait(5)
            except Exception:
                p.kill()



class ClassServer:
    """Lets students use the admin's AI without their own key. Stores only usage counts and feedback, never questions or code."""

    def __init__(self, upstream):
        self.upstream = upstream
        self.db = sqlite3.connect(os.path.join(DIR, "class.db"), check_same_thread=False)
        self.lock = threading.Lock()
        with self.lock:
            self.db.execute("CREATE TABLE IF NOT EXISTS usage (ts REAL, sid TEXT, chars INTEGER)")
            self.db.execute("CREATE INDEX IF NOT EXISTS usage_sid_ts ON usage(sid, ts)")
            self.db.execute("CREATE TABLE IF NOT EXISTS feedback (ts REAL, sid TEXT, tool TEXT, rating INTEGER, text TEXT)")
            self.db.commit()
        self.httpd = None
        self.code = ""
        self.limit_day, self.limit_total, self.gap = 40, 1500, 4.0
        self.last = {}
        self.sem = threading.Semaphore(4)

    def running(self):
        return self.httpd is not None

    @staticmethod
    def midnight():
        t = time.localtime()
        return time.mktime((t.tm_year, t.tm_mon, t.tm_mday, 0, 0, 0, 0, 0, -1))

    def counts(self, sid=None):
        with self.lock:
            if sid:
                return self.db.execute("SELECT COUNT(*) FROM usage WHERE sid=? AND ts>=?", (sid, self.midnight())).fetchone()[0]
            return self.db.execute("SELECT COUNT(*) FROM usage WHERE ts>=?", (self.midnight(),)).fetchone()[0]

    def rows(self):
        with self.lock:
            return self.db.execute("SELECT sid, COALESCE(SUM(ts>=?),0), COUNT(*), MAX(ts) FROM usage GROUP BY sid ORDER BY MAX(ts) DESC",
                                   (self.midnight(),)).fetchall()

    def feedback(self, n=300):
        with self.lock:
            return self.db.execute("SELECT ts, sid, tool, rating, text FROM feedback ORDER BY ts DESC LIMIT ?", (n,)).fetchall()

    def add_feedback(self, sid, tool, rating, text):
        with self.lock:
            self.db.execute("INSERT INTO feedback VALUES (?,?,?,?,?)", (time.time(), sid, tool, rating, text))
            self.db.commit()

    def start(self, port, code, limit_day, limit_total):
        self.code, self.limit_day, self.limit_total = code, int(limit_day), int(limit_total)
        srv = self

        class H(BaseHTTPRequestHandler):
            def log_message(self, *a):
                pass

            def out(self, status, obj):
                b = json.dumps(obj).encode()
                self.send_response(status)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(b)))
                self.end_headers()
                self.wfile.write(b)

            def authed(self):
                tok = self.headers.get("Authorization", "")
                tok = tok[7:] if tok.startswith("Bearer ") else ""
                return bool(srv.code) and hmac.compare_digest(tok.encode(), srv.code.encode())

            def sid_of(self, body):
                s = self.headers.get("X-ByteBot-Id") or (body or {}).get("user") or self.client_address[0]
                return re.sub(r"[^A-Za-z0-9_.-]", "", str(s))[:24] or "unknown"

            def do_GET(self):
                if self.path.rstrip("/") == "/v1/models":
                    if not self.authed():
                        return self.out(401, {"error": {"message": "Wrong class code."}})
                    return self.out(200, {"object": "list", "data": [{"id": "bytebot", "object": "model"}]})
                self.out(404, {"error": {"message": "not found"}})

            def do_POST(self):
                try:
                    n = int(self.headers.get("Content-Length", "0"))
                    if n > 200000:
                        raise ValueError
                    body = json.loads(self.rfile.read(n) or b"{}")
                except Exception:
                    return self.out(400, {"error": {"message": "Bad request."}})
                if not self.authed():
                    return self.out(401, {"error": {"message": "Wrong class code. Check the ByteBot Hub settings."}})
                sid = self.sid_of(body)
                path = self.path.rstrip("/")
                if path == "/feedback":
                    try:
                        rating = max(1, min(5, int(body.get("rating", 0))))
                    except Exception:
                        return self.out(400, {"error": {"message": "Rating must be 1 to 5."}})
                    srv.add_feedback(sid, str(body.get("tool", ""))[:20], rating, str(body.get("text", ""))[:1000])
                    return self.out(200, {"ok": True})
                if path != "/v1/chat/completions":
                    return self.out(404, {"error": {"message": "not found"}})
                now = time.time()
                if now - srv.last.get(sid, 0) < srv.gap:
                    return self.out(429, {"error": {"message": "Slow down a little and try again in a few seconds."}})
                if srv.counts(sid) >= srv.limit_day:
                    return self.out(429, {"error": {"message": "Daily limit reached (%d questions). Come back tomorrow." % srv.limit_day}})
                if srv.counts() >= srv.limit_total:
                    return self.out(429, {"error": {"message": "The class AI is resting for today. Try again tomorrow."}})
                msgs = body.get("messages") or []
                system = "\n".join(str(m.get("content", "")) for m in msgs if m.get("role") == "system")[:8000]
                chat = [{"role": "assistant" if m.get("role") == "assistant" else "user", "content": str(m.get("content", ""))[:6000]}
                        for m in msgs if m.get("role") in ("user", "assistant")][-12:]
                if not chat:
                    return self.out(400, {"error": {"message": "Empty question."}})
                srv.last[sid] = now
                with srv.sem:
                    text, err = ask_upstream(srv.upstream(), system, chat)
                if err:
                    return self.out(502, {"error": {"message": err}})
                with srv.lock:
                    srv.db.execute("INSERT INTO usage VALUES (?,?,?)", (time.time(), sid, sum(len(m["content"]) for m in chat) + len(text)))
                    srv.db.commit()
                self.out(200, {"id": "chatcmpl-" + secrets.token_hex(4), "object": "chat.completion", "model": "bytebot",
                               "choices": [{"index": 0, "message": {"role": "assistant", "content": text}, "finish_reason": "stop"}]})

        self.httpd = ThreadingHTTPServer(("0.0.0.0", int(port)), H)
        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()

    def stop(self):
        if self.httpd:
            self.httpd.shutdown()
            self.httpd.server_close()
            self.httpd = None



