            self.root.clipboard_clear()
            self.root.clipboard_append(self.join_text())
            messagebox.showinfo("Copied", self.join_text())

        def export_student(self):
            if not self.cls.running() and not self.set_class(True):
                return
            url = "http://%s:%s" % (local_ip(), self.cl_port.get())
            preset = json.dumps({"name": self.cl_name.get().strip() or "Class", "url": url, "base": url + "/v1", "code": self.cl_code.get().strip()})
            src = open(os.path.abspath(__file__), encoding="utf-8").read()
            out_src, n = re.subn(r'(?m)^PRESET = ".*"$', lambda m: "PRESET = " + json.dumps(preset), src, count=1)
            if n != 1:
                messagebox.showerror("Export", "Could not prepare the student file.")
                return
            out = os.path.join(os.path.expanduser("~"), "Desktop", "bytebot_student.pyw")
            with open(out, "w", encoding="utf-8") as fh:
                fh.write(out_src)
            messagebox.showinfo("Student Hub created", "Created:\n%s\n\nSend this one file to your students. They just double-click it: "
                                "no API key, no setup. Keep this PC and the class server running while they use it, "
                                "and they must be on the same network." % out)

        def refresh_class(self):
            rows = self.cls.rows()
            fb = self.cls.feedback()
            self.cls_stats["students"].config(text=str(len([r for r in rows if (r[1] or 0) > 0])))
            self.cls_stats["today"].config(text=("%d / %d" % (self.cls.counts(), self.cls.limit_total)) if self.cls.running() else str(self.cls.counts()))
            self.cls_stats["total"].config(text=str(sum(r[2] for r in rows)))
            self.cls_stats["fb"].config(text=str(len(fb)))
            if self.cur_page == "class":
                self.cls_tree.delete(*self.cls_tree.get_children())
                for sid, today, total, last in rows:
                    self.cls_tree.insert("", "end", values=(sid, int(today or 0), total, time.strftime("%d %b  %H:%M", time.localtime(last))))
            if self.cur_page == "feedback":
                self.fill_feedback(fb)

