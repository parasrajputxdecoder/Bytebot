        def update_explain(self):
            if self.cfg["mode"] == "hard":
                head = "Hard mode: only coding gets through. Apps, browser and YouTube are locked the same way."
                apps = "Apps outside your list are closed (save prompts appear first). No way around it until the timer ends."
                web = "Limited to LeetCode and Codeforces. Needs the extension; without it, only YouTube is controlled."
                yt = "Fully blocked. Every YouTube tab is closed the moment it opens."
            else:
                head = "Study mode: learning tools stay open. Apps, browser and YouTube follow the same rules."
                apps = "Apps outside your allowed list are minimized the moment they open."
                web = "Learning sites stay open. With the extension, only study channels and coding sites load."
                yt = "Plays only if the title has a study word (see Allowed apps). Other YouTube tabs are closed."
            self.explain.config(text=head)
            for t, text in zip(self.lock_txt, (apps, web, yt)):
                t.config(text=text)

        def update_stats(self):
            log = load_json(LOG_F, [])
            t = time.localtime()
            midnight = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, 0, 0, 0, 0, 0, -1))
            today = sum(e.get("mins", 0) for e in log if e.get("ts", 0) >= midnight)
            week = sum(e.get("mins", 0) for e in log if e.get("ts", 0) >= midnight - 6 * 86400)
            done = len([e for e in log if e.get("done")])
            fmt = lambda m: "%dh %02dm" % (m // 60, m % 60) if m >= 60 else "%d min" % m
            for v, text in zip(self.stat_vals, (fmt(today), fmt(week), str(done))):
                v.config(text=text)

