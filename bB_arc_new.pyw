        def show_class_info(self):
            self.cl_info.config(text="Running. Students join with  http://%s:%s  and code %s.  Students on the same Wi-Fi / network can reach it." %
                                (local_ip(), self.cl_port.get(), self.cl_code.get()), fg=OK)

        def set_class(self, on):
            if not on:
                if self.cls.running():
                    self.cls.stop()
                self.set("class_on", False)
                self.cl_info.config(text="Server is off.", fg=MUT)
                self.t_class.set(False)
                return False
            if self.cls.running():
                self.t_class.set(True)
                return True
            try:
                port, day, total = int(self.cl_port.get()), int(self.cl_day.get()), int(self.cl_total.get())
            except ValueError:
                messagebox.showerror("Class AI", "Port and limits must be numbers.")
                self.t_class.set(False)
                return False
            if not self.cl_code.get().strip():
                self.cl_code.set("CLASS-" + secrets.token_hex(3).upper())
            for k, v in (("class_port", str(port)), ("class_day", str(day)), ("class_total", str(total)), ("class_code", self.cl_code.get().strip()),
                         ("class_name", self.cl_name.get().strip() or "My class"), ("class_on", True)):
                self.set(k, v)
            try:
                self.cls.start(port, self.cl_code.get().strip(), day, total)
            except Exception as e:
                messagebox.showerror("Class AI", "Could not start (port busy?): %s" % e)
                self.t_class.set(False)
                return False
            self.t_class.set(True)
            self.show_class_info()
            return True

        def on_class_toggle(self, on):
            self.set_class(on)

        def join_text(self):
            return "ByteBot class AI\nServer: http://%s:%s\nClass code: %s" % (local_ip(), self.cl_port.get(), self.cl_code.get())

